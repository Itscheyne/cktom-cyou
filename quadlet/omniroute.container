#omniroute.container
[Unit]
Description=OmniRoute — Unified AI Proxy
After=network-online.target
Wants=network-online.target
Requires=omniroute-redis.service
After=omniroute-redis.service

[Container]
# Use this image after building locally
#Image=localhost/omniroute:base
# Or use the fully qualified published image (there is no published :base tag)
Image=docker.io/diegosouzapw/omniroute:latest

ContainerName=omniroute

Network=internal.network

# Traefik labels
Label=traefik.enable=true
Label=traefik.http.routers.omniroute.entrypoints=port443
Label=traefik.http.routers.omniroute.rule=Host(`omniroute.prod.sf.cktom.cyou`)
Label=traefik.http.routers.omniroute.tls=true
Label=traefik.http.routers.omniroute.service=omniroute
Label=traefik.http.services.omniroute.loadbalancer.server.port=20128
#Label=traefik.http.services.omniroute.loadbalancer.responseforwarding.flushinterval=100ms
# If you also need the API port routed:
Label=traefik.http.routers.omniroutews.entrypoints=port443
Label=traefik.http.routers.omniroutews.rule=Host(`ws.omniroute.prod.sf.cktom.cyou`)
Label=traefik.http.routers.omniroutews.tls=true
Label=traefik.http.routers.omniroutews.service=omniroutews
Label=traefik.http.services.omniroutews.loadbalancer.server.port=20129

# PublishPort commented out because Traefik handles ingress
# PublishPort=20128:20128
# PublishPort=20129:20129
#PublishPort=20132:20132

Volume=omniroute.volume:/app/data:Z

# Use a bind mount if you need direct host access to the data:
# Volume=/home/USER/code/docker/OmniRoute/data:/app/data:Z

Environment=DATA_DIR=/app/data

Environment=PORT=20128
Environment=LIVE_WS_PORT=20129
Environment=LIVE_WS_HOST=0.0.0.0
#Environment=LIVE_WS_ALLOWED_HOSTS=omniroute.prod.sf.cktom.cyou
Environment=NEXT_PUBLIC_BASE_URL=https://omniroute.prod.sf.cktom.cyou
Environment=NEXT_PUBLIC_LIVE_WS_PUBLIC_URL=wss://ws.omniroute.prod.sf.cktom.cyou
Environment=API_HOST=0.0.0.0
#Environment=AUTH_COOKIE_SECURE=true #Sets the Secure flag on session cookies. Must be true when running behind HTTPS.

Environment=REDIS_URL=redis://redis:6379
Secret=omniroute-jwt-secret,type=env,target=JWT_SECRET
Secret=omniroute-api-key-secret,type=env,target=API_KEY_SECRET
#Secret=omniroute-initial-password,type=env,target=INITIAL_PASSWORD
#
Environment=NODE_ENV=production
Environment=REQUIRE_API_KEY=true
Environment=CLI_COMPAT_ALL=1
Environment=CREDENTIAL_HEALTH_CHECK_INTERVAL=600000
Environment=CREDENTIAL_HEALTH_CACHE_TTL=600000
Environment=OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=TRUE

Environment=OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=8
Environment=OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=15000

Environment=CREDENTIAL_REDACTION_ENABLED=true
Environment=PII_RESPONSE_SANITIZATION=true

Environment=OMNIROUTE_MCP_COMPRESS_DESCRIPTIONS=true



# Load additional secrets (API keys, OAuth creds) from the project .env:
# EnvironmentFile=%h/code/docker/OmniRoute/.env

HealthCmd=node /app/healthcheck.mjs
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=15s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
