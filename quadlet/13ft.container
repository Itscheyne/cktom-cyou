#/etc/containers/systemd/13ft.container
[Unit]
Description=13ft Container Quadlet

[Service]
Restart=on-abnormal
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Container]
ContainerName=13ft
Image=ghcr.io/wasi-master/13ft:latest
AutoUpdate=registry
Pull=newer	

#PublishPort=5000:5000
Network=internal.network

#Add labels for traefik
Label="traefik.enable=true"
Label="traefik.http.routers.13ft.entrypoints=entryPoint443"
Label="traefik.http.routers.13ft.rule=Host(`13ft.cktom.cyou`)"
Label="traefik.http.routers.13ft.tls=true"
Label="traefik.http.routers.13ft.tls.certresolver=cloudflareResolver"
Label="traefik.http.routers.13ft.service=13ft"
# This next line is the crucial fix for the TLS error
Label="traefik.http.services.13ft.loadbalancer.server.scheme=http"
Label="traefik.http.services.13ft.loadbalancer.server.port=5000"
# Add a middleware to remove the /13ft path before forwarding to the container
#Label="traefik.http.middlewares.13ft-stripprefix.stripprefix.prefixes=/13ft"
#Label="traefik.http.routers.13ft.middlewares=13ft-stripprefix"
Pod=services.pod
